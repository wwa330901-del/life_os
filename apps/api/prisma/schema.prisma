// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SpaceType {
  PERSONAL
  COMPANY
  CALENDAR
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  PM
  MEMBER
}

enum PropertyType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum FinanceAccountType {
  CASH
  BANK
  CREDIT_CARD
  OTHER
}

enum FinanceCategoryKind {
  INCOME
  EXPENSE
}

/// LOAN_OUT/LOAN_IN and ADVANCE_OUT/ADVANCE_IN move real cash in/out of a
/// FinanceAccount (computeBalanceDeltas must handle them) but are
/// deliberately excluded from every 收入/支出 aggregation (monthlySummary,
/// budgets, home dashboard, AI 問答 tools) — those all filter on an
/// INCOME/EXPENSE allowlist, so a new type here is excluded automatically
/// without needing to touch that filtering logic. Same reasoning as
/// TRANSFER: money moved, but it isn't real income or spending.
enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  LOAN_OUT
  LOAN_IN
  ADVANCE_OUT
  ADVANCE_IN
}

enum FinanceLoanDirection {
  LEND
  BORROW
}

/// How a 定期交易 whose trigger date lands on a holiday (weekend or Taiwan
/// government holiday) should shift: not at all, to the nearest earlier
/// working day, or to the nearest later working day.
enum FinanceRecurringHolidayAdjustment {
  NONE
  EARLIER
  LATER
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null for accounts created via Google sign-in that never set a password.
  passwordHash String?

  // Null until the registration email's code is confirmed. Google sign-in
  // sets this immediately (Google already verified the address).
  emailVerifiedAt           DateTime?
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  // Null unless the account is linked to (or was created via) Google sign-in.
  googleId String? @unique

  // Platform-wide admin: can manage all accounts and all spaces' membership.
  // Distinct from CompanyMembership roles, which only grant access within
  // one company space.
  isPlatformAdmin Boolean @default(false)

  /// This user's own Gemini API key (aistudio.google.com), used for their
  /// own 知識庫 AI analysis so usage bills to their own Google account, not
  /// a shared platform-wide key. Null = feature unusable for them (no
  /// fallback to any shared key, by explicit design). Plain column, same
  /// as this schema's other third-party secrets (e.g.
  /// GoogleCalendarConnection.refreshToken) — Postgres access itself is
  /// the trust boundary.
  geminiApiKey String?

  /// This user's 首頁 widget layout — which widgets are shown and in what
  /// order, e.g. `{ widgets: [{ type: "personalFinance", visible: true },
  /// ...] }`. Null means "use the default layout" (all widgets, default
  /// order) rather than an empty list meaning "hide everything", so a
  /// brand-new widget added in a future release still shows up for
  /// existing users instead of silently staying hidden until they touch
  /// the settings themselves. Server-side (not local-only) so it survives
  /// a reinstall/new machine, same as every other piece of user data.
  homeLayoutConfig Json?

  personalSpace              Space?                     @relation("PersonalSpaceOwner")
  calendarSpace              Space?                     @relation("CalendarSpaceOwner")
  memberships                CompanyMembership[]
  projectMemberships         ProjectMember[]
  generatedDocuments         GeneratedDocument[]
  lineAccountLink            LineAccountLink?
  assignedTodos              ProjectTodo[]              @relation("TodoAssignee")
  personalTodos              ProjectTodo[]              @relation("TodoPersonalOwner")
  googleCalendarConnections  GoogleCalendarConnection[]
  documentApprovalsSubmitted DocumentApproval[]
  documentApprovalSteps      DocumentApprovalStep[]
  documentApprovalStepNotes  DocumentApprovalStepNote[]
  knowledgeCategories        KnowledgeCategory[]
  knowledgeItems             KnowledgeItem[]
  aiUsageLogs                AiUsageLog[]
}

model Space {
  id        String    @id @default(uuid())
  type      SpaceType
  name      String
  createdAt DateTime  @default(now())

  /// { propertyNames: string[], separator: string } — this company space's
  /// own rule for suggesting a new project's 案名 by joining the named
  /// properties' values (in this order) with this separator. Null means no
  /// suggestion (使用者手動輸入), same as before this feature existed.
  /// Applied once at project-creation time only (`CreateProjectDialog`) —
  /// never retroactively re-applied when a property value changes later.
  projectNameTemplate Json?

  // Only set when type = PERSONAL. Each user has exactly one personal space.
  ownerUserId String? @unique
  owner       User?   @relation("PersonalSpaceOwner", fields: [ownerUserId], references: [id])

  // Only set when type = CALENDAR. Each user has at most one calendar space
  // — a separate 1:1-per-user slot from the personal space above (a user
  // can have both), created on demand rather than at signup.
  calendarOwnerUserId String? @unique
  calendarOwner       User?   @relation("CalendarSpaceOwner", fields: [calendarOwnerUserId], references: [id])

  memberships                  CompanyMembership[]
  projects                     Project[]
  propertyDefinitions          ProjectPropertyDefinition[]
  documentTemplates            DocumentTemplate[]
  generatedDocuments           GeneratedDocument[]
  financeAccounts              FinanceAccount[]
  financeCategories            FinanceCategory[]
  financeTransactions          FinanceTransaction[]
  financeBudgets               FinanceBudget[]
  financeRecurringTransactions FinanceRecurringTransaction[]
  financeLoans                 FinanceLoan[]
  financeAdvances              FinanceAdvance[]
  calendarEvents               CalendarEvent[]
  googleCalendarConnection     GoogleCalendarConnection?
  stockTransactions            StockTransaction[]
  stockRecurringInvestments    StockRecurringInvestment[]
}

/// One event on a CALENDAR space's calendar. Independent of ProjectTodo —
/// the calendar screen additionally overlays project todos' due dates
/// read-only alongside these, but editing a todo still happens on its
/// project's 代辦事項 tab, not here.
model CalendarEvent {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title    String
  location String?
  notes    String?
  startAt  DateTime
  endAt    DateTime?
  allDay   Boolean   @default(false)

  /// Google Calendar's event id, once pushed/pulled — null means either
  /// "not yet synced" or "this space has no Google connection".
  googleEventId String?

  /// Set only for an event TodosService auto-created from a todo's due
  /// date/time (one-way 代辦事項→行事曆 sync, 2026-08-05 — the reverse
  /// direction is deliberately not a thing, editing this event directly
  /// never writes back to the todo). onDelete: Cascade here means deleting
  /// the source ProjectTodo takes this event with it as a DB-level
  /// safety net, but TodosService.remove also explicitly calls
  /// CalendarEventsService.remove first so the Google-side delete actually
  /// fires (a raw cascade delete wouldn't reach Google).
  sourceTodoId String?      @unique
  sourceTodo   ProjectTodo? @relation("TodoSyncedEvent", fields: [sourceTodoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, googleEventId])
  @@index([spaceId, startAt])
}

/// A CALENDAR space's link to one Google Calendar (always the connecting
/// user's "primary" calendar for now — no per-space calendar picker yet).
/// `refreshToken` follows this codebase's existing pattern of storing
/// third-party secrets as plain columns (no field-level encryption anywhere
/// else in this schema either) — Postgres access itself is the trust
/// boundary. `syncToken` is Google's incremental-sync cursor; null forces a
/// full resync (e.g. right after connecting, or if Google invalidates it).
model GoogleCalendarConnection {
  id      String @id @default(uuid())
  spaceId String @unique
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  syncToken            String?
  lastSyncedAt         DateTime?

  connectedByUserId String
  connectedBy       User   @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One document template a space can generate for its projects — a
/// pre-tagged `.docx` (`{{fieldKey}}` placeholders in place of the original
/// blanks) that gets filled with a project's data via docxtemplater and
/// handed back byte-identical to the source layout. Ingested by hand (see
/// 大系統 doc) rather than through a self-service upload UI — the tagging
/// step needs a human (well, an AI) to actually read the document and
/// figure out where the blanks are.
model DocumentTemplate {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  code     String // e.g. "JWD-3-1" — this space's own code, per its own numbering scheme
  name     String // e.g. "裝修工程承攬合約書"
  category String // human label for the code's category digit, e.g. "合約" — display only

  docxData Bytes // the tagged .docx, ready for docxtemplater

  /// [{ key, label, type?, source?, writesTo? }] — `type` is `"text"`
  /// (default) or `"date"`. `source` is one of `null` (always manual),
  /// `"project.name"` / `"project.startDate"` (the project's own fixed
  /// fields), or `"property:<name>"` (look up by name in the project's own
  /// propertyValues) — see ProjectPropertyDefinition/Value. `writesTo` is
  /// the reverse: for a `date` field, `"project.endDate"` means the value
  /// picked when filling this template is written back onto the project's
  /// own `projectEndDate` (e.g. a contract's 完工日 setting 預計結案日).
  fields Json

  /// ProjectPropertyOption ids under this space's "類型" property — which
  /// project types this template is offered for.
  allowedTypeOptionIds String[] @default([])

  /// Whether a document generated from this template can be 送簽 (submitted
  /// into the DocumentApproval workflow below). Set by hand by whoever
  /// manages this space's templates — deliberately NOT derived from the
  /// `code` numbering convention (e.g. this space's own "01=對外/02=對內"
  /// scheme), since that's a human convention the system never parses.
  requiresApproval Boolean @default(false)

  createdAt DateTime @default(now())

  generatedDocuments GeneratedDocument[]

  @@unique([spaceId, code])
}

/// A document actually generated from a DocumentTemplate for a specific
/// project — the persisted result of filling in a template's fields, kept
/// as a record inside the app (not just a one-time download) so it can be
/// referenced later and, eventually, routed through a company approval/
/// sign-off workflow once that exists. `templateId` is nullable with
/// onDelete: SetNull so a generated document survives its template being
/// edited or removed — it already carries its own rendered `docxData` and
/// a snapshot of the values that were filled in, so it doesn't depend on
/// the template still existing unchanged.
model GeneratedDocument {
  id String @id @default(uuid())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name String // defaults to the template's name at generation time

  /// The exact field values used to fill the template ({key: value}),
  /// kept for display/audit even after the template itself changes.
  values Json

  docxData Bytes // the rendered result — re-download doesn't re-run docxtemplater

  createdAt DateTime @default(now())

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  approvals DocumentApproval[]

  @@index([projectId])
}

enum DocumentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentApprovalStepNoteType {
  REQUEST_INFO
  REPLY
}

/// One 送簽 attempt for a GeneratedDocument — a document can have several of
/// these over time (a REJECTED one is terminal; the creator revises and
/// submits a fresh one), but only ever one PENDING at a time (enforced in
/// DocumentApprovalsService, not the schema). Once one reaches APPROVED,
/// the document is locked (see GeneratedDocumentsService.removeGenerated /
/// the docs module's delete guard) — that generated file is now the
/// signed-off record and can't be deleted or replaced.
model DocumentApproval {
  id String @id @default(uuid())

  generatedDocumentId String
  generatedDocument   GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedBy       User   @relation(fields: [submittedByUserId], references: [id])

  status DocumentApprovalStatus @default(PENDING)

  createdAt DateTime @default(now())

  steps DocumentApprovalStep[]

  @@index([generatedDocumentId])
}

/// One ordered checkpoint in a DocumentApproval's chain. The "current" step
/// is the lowest-`sequence` one still PENDING while every lower-sequence
/// step in the same approval is APPROVED — computed in application code,
/// not stored. A REJECTED step immediately flips the parent
/// DocumentApproval to REJECTED and ends the chain (no "resume from here"
/// — see 大系統 doc for why: the user explicitly chose the simpler
/// reject-and-resubmit flow over a resumable one).
model DocumentApprovalStep {
  id String @id @default(uuid())

  approvalId String
  approval   DocumentApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  sequence Int

  approverUserId String
  approver       User   @relation(fields: [approverUserId], references: [id])

  status DocumentApprovalStatus @default(PENDING)

  /// Optional on an APPROVE, required (enforced in the service) on a REJECT.
  decisionComment String?
  decidedAt       DateTime?

  notes DocumentApprovalStepNote[]

  @@unique([approvalId, sequence])
  @@index([approverUserId, status])
}

/// A back-and-forth thread attached to one step, for "審核人有疑問但還不到
/// 退回的地步" — a REQUEST_INFO note doesn't change the step's status; the
/// submitter's REPLY doesn't either. The step only ever resolves via a real
/// APPROVE or REJECT decision on DocumentApprovalStep itself.
model DocumentApprovalStepNote {
  id String @id @default(uuid())

  stepId String
  step   DocumentApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id])

  type DocumentApprovalStepNoteType
  text String

  createdAt DateTime @default(now())

  @@index([stepId])
}

/// One property a space has defined for its projects — the "columns" of
/// that space's own project-info shape, each space customizes this itself
/// (not platform-wide, unlike the ProjectTypeOption/ProjectStatusOption
/// this is replacing — see schema.prisma history / 大系統 doc for why).
model ProjectPropertyDefinition {
  id        String       @id @default(uuid())
  name      String
  type      PropertyType
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  options ProjectPropertyOption[]
  values  ProjectPropertyValue[]
}

/// The choices for one SELECT-type property definition.
model ProjectPropertyOption {
  id        String   @id @default(uuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  definitionId String
  definition   ProjectPropertyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  values ProjectPropertyValue[]
}

/// One project's value for one property definition. Exactly one of
/// textValue/numberValue/dateValue/optionId is populated, chosen by
/// `definition.type` — a single table with a nullable column per type
/// rather than a true polymorphic split, the practical default for a
/// small fixed set of value shapes.
model ProjectPropertyValue {
  id String @id @default(uuid())

  textValue   String?
  numberValue Float?
  dateValue   DateTime?

  optionId String?
  option   ProjectPropertyOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  definitionId String
  definition   ProjectPropertyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([projectId, definitionId])
}

model CompanyMembership {
  id        String         @id @default(uuid())
  role      MembershipRole
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])

  @@unique([userId, spaceId])
}

model ProjectTypeOption {
  id        String   @id @default(uuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  projects Project[]
}

model ProjectStatusOption {
  id        String   @id @default(uuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  projects Project[]
}

model Project {
  id   String @id @default(uuid())
  name String

  /// clientName/siteAddress/caseNumber/type/status below are the old
  /// fixed fields, now superseded by the per-space ProjectPropertyValue
  /// system — loosened to nullable (not removed) since new projects go
  /// through the new system and never populate these. Left in place as a
  /// stage-1 safety net; stage 2 (once the new system is verified) drops
  /// them for real.
  clientName  String?
  siteAddress String?
  caseNumber  String?

  typeId String?
  type   ProjectTypeOption? @relation(fields: [typeId], references: [id])

  statusId String?
  status   ProjectStatusOption? @relation(fields: [statusId], references: [id])

  // Baseline anchor date: items with no predecessors start here. Date-only —
  // no time-of-day, no timezone (see WorkItem's date fields for the same rule).
  projectStartDate DateTime @db.Date

  // Contract-committed completion date (預計結案日) — nullable since it's
  // usually unset until a 完工日-bearing contract (e.g. the 裝修工程承攬合約書
  // template) is actually filled and signed; see DocumentField's `writesTo`
  // for how filling a contract writes here. Once set, the schedule engine
  // compares the computed finish date against it and raises a
  // SchedulingIssue if the forecast has slipped past it.
  projectEndDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])

  // Holiday calendar, flattened onto Project rather than a separate model or a
  // Json column: it's always 1:1 with a Project, never queried independently,
  // and flattened scalar columns let PATCH /projects/:id/calendar validate
  // each sub-field individually with ordinary class-validator decorators.
  weeklyOffDays               Int[]      @default([7]) // Dart DateTime.monday..sunday (1..7); default {Sunday=7}
  useTaiwanGovernmentCalendar Boolean    @default(true)
  adHocHolidays               DateTime[] @default([]) @db.Date
  adHocWorkdays               DateTime[] @default([]) @db.Date

  items              WorkItem[]
  members            ProjectMember[]
  propertyValues     ProjectPropertyValue[]
  generatedDocuments GeneratedDocument[]
  todos              ProjectTodo[]
  lineActiveFor      LineAccountLink[]
  financeAdvances    FinanceAdvance[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  role      ProjectRole
  createdAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model WorkItem {
  id           String @id @default(uuid())
  name         String
  durationDays Int

  // 實際開始日期／實際工期 — when this item actually started and how many
  // days it actually took, filled in separately from (and independently
  // of) startDate（scheduler-computed）/durationDays/預計工期, which stay
  // the planned estimate the schedule engine anchors off. Both null until
  // the user records them — either can be set alone (e.g. "started but
  // still running" only has actualStartDate). Deliberately excluded from
  // every export (Gantt image/PDF etc. only ever render the planned
  // schedule) — this is a private, after-the-fact tracking field, not part
  // of the shareable schedule.
  actualStartDate    DateTime? @db.Date
  actualDurationDays Int?

  // IDs of work items that must finish before this one can start. A plain
  // array column (not a join table / FK) on purpose: the scheduler already
  // tolerates dangling references as a non-fatal SchedulingIssue rather than
  // erroring, which a real FK constraint would fight against for no benefit
  // at this scale (tens to low hundreds of items per project).
  predecessorIds String[] @default([])

  tradeCategory   String?
  colorValue      Int?
  progressPercent Float   @default(0)
  notes           String?

  // If set (with isManuallyPinned), the scheduler anchors this item's start
  // date here instead of computing it from predecessors.
  manualStartDate  DateTime? @db.Date
  isManuallyPinned Boolean   @default(false)

  sortOrder Int @default(0)

  // Parent work item, or null for a top-level item. Whether an item is a
  // summary/parent row is derived dynamically (something else points at it
  // via parentId) — not a stored flag. No DB-level cascade on this
  // self-relation (Postgres rejects multiple cascade paths into the same
  // table) — descendant cleanup on delete is handled in application code.
  parentId String?
  parent   WorkItem?  @relation("WorkItemChildren", fields: [parentId], references: [id])
  children WorkItem[] @relation("WorkItemChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// First 個人功能 module: a personal-space money container (現金/銀行/信用卡/
/// 其他), 記帳系統's "帳戶". Balance is derived (initialBalance plus every
/// transaction against it, including transfers in/out) rather than stored,
/// so it never drifts out of sync with the transaction log.
model FinanceAccount {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name           String
  type           FinanceAccountType
  initialBalance Float              @default(0)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  transactions FinanceTransaction[] @relation("AccountTransactions")
  transfersIn  FinanceTransaction[] @relation("TransferToAccount")

  recurringAsSource FinanceRecurringTransaction[] @relation("RecurringSourceAccount")
  recurringAsTarget FinanceRecurringTransaction[] @relation("RecurringToAccount")

  stockTransactions         StockTransaction[]
  stockRecurringInvestments StockRecurringInvestment[]
}

/// A 記帳 category (收入/支出), user-managed per personal space from day
/// one — no platform-wide fixed list, same "each space owns its own"
/// pattern as ProjectPropertyDefinition.
model FinanceCategory {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name      String
  kind      FinanceCategoryKind
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  // 母分類/子分類 — exactly two levels (a category with a parentId can't
  // itself have children; enforced in application code, not the DB). Null
  // parentId = 母分類. A 母分類 with at least one child can't be used
  // directly on a transaction anymore — the child is the specific
  // classification, the parent is just the rollup grouping shown in
  // 總覽/報表/預算 (see FinanceTransaction.categoryId comment). A parent
  // with zero children stays directly usable, unchanged from before this
  // feature existed.
  parentId String?
  parent   FinanceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children FinanceCategory[] @relation("CategoryHierarchy")

  transactions          FinanceTransaction[]
  budget                FinanceBudget?
  recurringTransactions FinanceRecurringTransaction[]

  @@unique([spaceId, name, kind, parentId])
}

model FinanceTransaction {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  type   FinanceTransactionType
  amount Float

  accountId String
  account   FinanceAccount @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  // Only set for `type = TRANSFER` — the other side of the money movement.
  toAccountId String?
  toAccount   FinanceAccount? @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  // Null for TRANSFER; required for INCOME/EXPENSE.
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Date-only, no time-of-day — same convention as Project/WorkItem's own
  // date fields.
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  // The following four are each set on exactly one row — the one
  // FinanceTransaction that represents a 借貸/代墊's *initial* cash move, or
  // one that represents a single repayment against it. Deliberately no
  // duplicated amount/date/account/note on FinanceLoan*/FinanceAdvance*
  // themselves — this transaction row is the single source of truth for
  // those, same "derive, don't duplicate" preference as FinanceAccount's
  // balance. onDelete: Cascade is defined here (the child) so deleting the
  // parent FinanceLoan/FinanceLoanRepayment/etc. also removes this row.
  financeLoanId String?      @unique
  financeLoan   FinanceLoan? @relation("LoanInitialTransaction", fields: [financeLoanId], references: [id], onDelete: Cascade)

  loanRepaymentId String?               @unique
  loanRepayment   FinanceLoanRepayment? @relation(fields: [loanRepaymentId], references: [id], onDelete: Cascade)

  financeAdvanceId String?         @unique
  financeAdvance   FinanceAdvance? @relation("AdvanceInitialTransaction", fields: [financeAdvanceId], references: [id], onDelete: Cascade)

  advanceRepaymentId String?                  @unique
  advanceRepayment   FinanceAdvanceRepayment? @relation(fields: [advanceRepaymentId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}

/// 跟人借錢/借錢給人 — a lightweight "receivable/payable" ledger, deliberately
/// separate from 代墊 even though the underlying mechanic (cash moves now,
/// settles later, never counted as real income/expense) is identical, per
/// explicit user choice ("完全分開做兩個獨立功能"). `direction` decides which
/// way both the initial transaction and every repayment's cash flows:
/// LEND → initial LOAN_OUT, repayments are LOAN_IN (money comes back);
/// BORROW → initial LOAN_IN, repayments are LOAN_OUT (money goes back out).
/// "Outstanding"/"settled" is always derived (initialTransaction.amount
/// minus the sum of repayments' transaction amounts), never stored.
model FinanceLoan {
  id               String               @id @default(uuid())
  spaceId          String
  space            Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  direction        FinanceLoanDirection
  // 跟誰借/借給誰 — free text, no contacts system.
  counterpartyName String
  createdAt        DateTime             @default(now())

  initialTransaction FinanceTransaction?    @relation("LoanInitialTransaction")
  repayments         FinanceLoanRepayment[]
}

model FinanceLoanRepayment {
  id        String      @id @default(uuid())
  loanId    String
  loan      FinanceLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  transaction FinanceTransaction?
}

/// 工作上先幫忙出錢，之後公司/專案還你 — see FinanceLoan's doc comment for why
/// this is a separate model rather than sharing one with a "purpose" field.
/// Always one-directional (advance out, then reimbursed in — there's no
/// "borrow" equivalent), so unlike FinanceLoan there's no direction field:
/// the initial transaction is always ADVANCE_OUT, every repayment is
/// always ADVANCE_IN. `projectId` is optional — set only when the user
/// chooses to tie this advance to a specific project's cost tracking.
model FinanceAdvance {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // 說明/事由，例如「材料款」— not a reference to any DocumentTemplate/etc.,
  // just a free-text label for what this advance was for.
  title     String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  initialTransaction FinanceTransaction?       @relation("AdvanceInitialTransaction")
  repayments         FinanceAdvanceRepayment[]
}

model FinanceAdvanceRepayment {
  id        String         @id @default(uuid())
  advanceId String
  advance   FinanceAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  transaction FinanceTransaction?
}

/// Standing monthly spending target per category — compared against that
/// month's actual FinanceTransaction total when the user looks at a given
/// month, not itself tied to one specific month (applies every month until
/// changed).
model FinanceBudget {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  categoryId    String          @unique
  category      FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyAmount Float

  createdAt DateTime @default(now())
}

/// A recurring 記帳 entry — the credit-card-bill use case: "every month on
/// day N, do something". `amount` is optional: set it for a fixed
/// recurring amount (rent, subscriptions) and the due day auto-creates the
/// FinanceTransaction plus a LINE notification saying so; leave it blank
/// for a variable amount (a credit card bill that's a different number
/// every month) and the due day just sends a LINE reminder — no
/// transaction gets created, the user records the real amount themselves.
model FinanceRecurringTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  type   FinanceTransactionType
  amount Float?
  note   String?

  /// 1-31. If the current month has fewer days than this, triggers on the
  /// month's actual last day instead (e.g. 31 in February triggers on the
  /// 28th/29th).
  dayOfMonth Int

  /// If the resulting date this month falls on a weekend or Taiwan
  /// government holiday, whether to fire early/late instead — checked
  /// against the same `isTaiwanHoliday` calendar used by 工期表 scheduling.
  holidayAdjustment FinanceRecurringHolidayAdjustment @default(NONE)

  active Boolean @default(true)

  accountId String
  account   FinanceAccount @relation("RecurringSourceAccount", fields: [accountId], references: [id], onDelete: Cascade)

  /// Only set for `type = TRANSFER` — the other side of the money movement.
  toAccountId String?
  toAccount   FinanceAccount? @relation("RecurringToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  /// Null for TRANSFER; only meaningful for INCOME/EXPENSE.
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// "YYYY-MM" of the last month this already fired in — stops the daily
  /// cron from double-firing if it runs more than once on the trigger day.
  lastTriggeredMonth String?
}

enum StockTransactionType {
  BUY
  SELL
}

/// A manually-entered stock buy/sell (personal-space 投資 module). `tradeDate`
/// is just the date it's registered on — the actual money movement doesn't
/// happen until `settlementDate` (tradeDate + 2 trading days, matching
/// Taiwan's real T+2 settlement), when `StockSettlementService`'s daily cron
/// creates the real FinanceTransaction and flips `settled`. Users provide
/// `pricePerShare` and `totalCost`; `shares` is derived (`totalCost /
/// pricePerShare`) so nobody has to do that math themselves — same
/// convention used by StockRecurringInvestment's DCA fill-ins.
model StockTransaction {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  stockCode String
  type      StockTransactionType

  pricePerShare Float
  totalCost     Float
  shares        Float

  tradeDate      DateTime @db.Date
  settlementDate DateTime @db.Date
  settled        Boolean  @default(false)

  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime @default(now())

  @@index([spaceId, stockCode])
  @@index([settlementDate, settled])
}

/// 定期定額（DCA）計畫 — same "每月第幾天＋遇假日調整" shape as
/// FinanceRecurringTransaction, but the amount is never fixed (a DCA fill
/// price varies every round), so the daily cron only ever sends a LINE
/// reminder, never auto-creates a transaction. `awaitingReply` is what lets
/// LineService tell a plain "股票代碼 成交價 投入成本" reply apart from a
/// regular 記帳/代辦 command — see `tryStockDcaReply`.
model StockRecurringInvestment {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  stockCode         String
  dayOfMonth        Int
  holidayAdjustment FinanceRecurringHolidayAdjustment @default(NONE)

  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  active             Boolean @default(true)
  lastTriggeredMonth String?
  awaitingReply      Boolean @default(false)

  createdAt DateTime @default(now())
}

/// Stock price cache — one row per stock code, shared across every space
/// (price data is public, not user-specific). `dailyClosePrice` is updated
/// once after market close via TWSE's official free OpenAPI
/// (STOCK_DAY_ALL); `intradayPrice` is opportunistically refreshed every
/// few minutes during trading hours via TWSE's unofficial realtime feed —
/// that feed isn't a published/versioned contract, so a fetch failure just
/// leaves the last known value in place (UI falls back to
/// `dailyClosePrice`) rather than erroring.
model StockPriceCache {
  stockCode String  @id
  stockName String?

  dailyClosePrice Float?
  dailyCloseDate  DateTime? @db.Date

  intradayPrice     Float?
  intradayUpdatedAt DateTime?

  updatedAt DateTime @updatedAt
}

/// Links a life_os user to their LINE account, so a message sent to the
/// 記帳 LINE bot knows whose personal space to record a transaction
/// against. Two states in one row rather than two tables: `linkCode` set +
/// `lineUserId` null means "waiting for the user to send this code from
/// LINE"; `lineUserId` set means linking is complete (`linkCode` cleared).
model LineAccountLink {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lineUserId        String?   @unique
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?

  /// The ordered ProjectTodo ids from the last "代辦事項"/"代辦事項總覽" list
  /// shown to this LINE user — lets "完成 2" reference an item by the
  /// number printed next to it instead of retyping its title (titles typed
  /// when completing something often don't match what was typed when it
  /// was created). Overwritten every time either list is (re-)shown;
  /// numbers don't shift after a completion within the same shown list.
  lastTodoListIds String[] @default([])

  /// Same numbered-list-reference pattern as `lastTodoListIds`, one each
  /// for 借貸/代墊 since "借貸列表"/"代墊列表" are two separate lists — lets
  /// "還款 2 1000"/"收回代墊 2 1000" reference an item by number.
  lastLoanListIds    String[] @default([])
  lastAdvanceListIds String[] @default([])

  /// Which project "新增/完成/代辦" commands apply to — unlike 記帳 (always
  /// the user's own 1:1 personal space), a company-space project is
  /// ambiguous when the user belongs to more than one, so this has to be
  /// picked once via a LINE quick-reply and remembered here until changed.
  activeProjectId String?
  activeProject   Project? @relation(fields: [activeProjectId], references: [id], onDelete: SetNull)

  /// Set when the user picked "個人" (not a project) as their 代辦事項
  /// target — takes priority over activeProjectId when true. Mutually
  /// exclusive with a meaningful activeProjectId by construction (picking
  /// one always clears the other), never both true/set at once.
  activeTodoPersonal Boolean @default(false)

  /// Set while a KnowledgeItem is AWAITING_CATEGORY_DECISION and this user
  /// has just been asked "建議新增 XX 分類" — their next plain-text reply
  /// ("新增" or an existing category name) resolves this specific item,
  /// same single-pending-slot pattern as StockRecurringInvestment.awaitingReply.
  pendingKnowledgeItemId String?

  /// Set to "美食"/"景點" right after the user taps that LINE rich-menu
  /// button — their next plain-text message is treated as the location to
  /// search, not a new command.
  pendingKnowledgeLocationQueryCategory String?

  /// Set after the user replies "安排" to an 展覽資訊 ending-soon reminder —
  /// their next plain-text reply is parsed as the date/time to schedule,
  /// which then creates the CalendarEvent + ProjectTodo for this item.
  pendingExhibitionScheduleItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A to-do item — distinct from 工項 (WorkItem, which is schedule/duration-
/// bearing and feeds the Gantt engine); a todo is a plain task with no
/// duration. Exactly one of projectId/personalOwnerUserId is set (enforced
/// by a DB check constraint in the migration, not just app code) — a 工作
/// todo belongs to a company-space project (optionally assigned to a
/// project member), a 個人 todo belongs directly to its owner with no
/// project at all. Model name kept as ProjectTodo (not renamed) even after
/// this split to avoid a wider rename across services/app for a cosmetic
/// gain — see 大系統V1.31.0.md.
model ProjectTodo {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  personalOwnerUserId String?
  personalOwner       User?   @relation("TodoPersonalOwner", fields: [personalOwnerUserId], references: [id], onDelete: Cascade)

  title       String
  done        Boolean   @default(false)
  completedAt DateTime?

  /// Every todo must have exactly one of dueDate/isOngoing set going
  /// forward (enforced in TodosService, not a DB constraint — a plain
  /// NOT NULL/CHECK would also reject the pre-existing rows that predate
  /// this rule (2026-08-03), which the user explicitly wants left alone
  /// rather than force-backfilled). isOngoing = a deliberate "no fixed
  /// date, recurring/persistent task" marker — distinct from just leaving
  /// dueDate empty, which is why it's its own flag rather than dueDate
  /// staying implicitly optional.
  /// 2026-08-05: widened from date-only to a full timestamp so a todo can
  /// optionally carry a time-of-day, same as CalendarEvent — existing rows
  /// keep reading back as UTC-midnight-of-that-date (unchanged meaning,
  /// just a wider column type), `dueDateAllDay` (default true, matching
  /// every pre-existing row's actual "no time" reality) is the
  /// CalendarEvent.allDay equivalent that says whether the time component
  /// means anything.
  dueDate       DateTime?
  dueDateAllDay Boolean      @default(true)
  isOngoing     Boolean      @default(false)
  priority      TodoPriority @default(MEDIUM)
  notes         String?

  assigneeUserId String?
  assignee       User?   @relation("TodoAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  /// The auto-created 行事曆 event mirroring this todo's due date/time, if
  /// any — see CalendarEvent.sourceTodoId for the full sync explanation.
  syncedCalendarEvent CalendarEvent? @relation("TodoSyncedEvent")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([personalOwnerUserId])
}

enum KnowledgeItemStatus {
  PENDING
  PROCESSING
  AWAITING_CATEGORY_DECISION
  DONE
  FAILED
}

/// Only meaningful when the item's category is 展覽資訊 — tracks whether the
/// "快結束了還沒去" LINE reminder has been answered yet, so the daily cron
/// doesn't keep re-asking once the user has already said 安排 or 不安排.
/// This is workflow state the automation itself manages, not a user-defined
/// field, which is why it's a fixed column instead of living in
/// KnowledgeFieldValue like 是否已觀展/結束日期 do.
enum KnowledgeExhibitionDecisionStatus {
  PENDING
  SCHEDULED
  CANCELLED
}

/// One knowledge-collection category a user has defined for themselves —
/// e.g. 美食/景點/展覽資訊 — independent module, not scoped to any Space
/// (see 大系統 doc: 知識庫 is account-level, not personal/company/calendar).
/// Sharing is at this granularity (a whole category, not per-item): making
/// a category public exposes every item under it — present and future — to
/// every other account on the platform except whoever's in `blacklistedUserIds`.
model KnowledgeCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  isPublic           Boolean  @default(false)
  blacklistedUserIds String[] @default([])

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  fields KnowledgeFieldDefinition[]
  items  KnowledgeItem[]

  @@unique([ownerUserId, name])
}

/// One custom field a category's owner has defined for it (e.g. 美食's
/// 店名/地址/評價) — same "each owner defines their own columns" pattern as
/// ProjectPropertyDefinition, just scoped to a KnowledgeCategory instead of
/// a Space. The AI content-analysis service is given the current category's
/// field list and asked to fill in a value per field when it analyzes new
/// content for that category.
model KnowledgeFieldDefinition {
  id        String       @id @default(uuid())
  name      String
  type      PropertyType
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  categoryId String
  category   KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  options KnowledgeFieldOption[]
  values  KnowledgeFieldValue[]
}

/// The choices for one SELECT-type field definition.
model KnowledgeFieldOption {
  id        String   @id @default(uuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  definitionId String
  definition   KnowledgeFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  values KnowledgeFieldValue[]
}

/// One saved thing — a URL (or a directly-sent JPG/PNG) the user dropped
/// into LINE, plus whatever the AI made of it. `categoryId` stays null while
/// `status` is PENDING/PROCESSING/AWAITING_CATEGORY_DECISION; once a
/// category is resolved (matched or freshly created) it's set and `status`
/// becomes DONE. `rawContent` is kept even after analysis (per the original
/// design brief's "保留原始資料") so a future model upgrade can re-analyze
/// without re-fetching the source.
model KnowledgeItem {
  id String @id @default(uuid())

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  categoryId String?
  category   KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status                KnowledgeItemStatus @default(PENDING)
  /// Set when the AI couldn't match any existing category — the name it
  /// suggested, shown to the user as "建議新增 XX 分類" while awaiting reply.
  suggestedCategoryName String?
  /// [{name, type}] the AI proposed for that new category — used verbatim
  /// if the user replies "新增"; kept separate from suggestedCategoryName
  /// since it's structured, not display text.
  suggestedFields       Json?
  errorMessage          String?

  sourceUrl      String?
  sourcePlatform String? // e.g. "IG", "YouTube", "網頁文章", "PDF", "圖片" — display only
  title          String?
  summary        String?
  tags           String[] @default([])
  rawContent     String?

  /// Only used when category = 展覽資訊 — see KnowledgeExhibitionDecisionStatus.
  exhibitionDecisionStatus KnowledgeExhibitionDecisionStatus?
  exhibitionPlannedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldValues KnowledgeFieldValue[]

  @@index([ownerUserId, categoryId])
  @@index([status])
}

/// One item's value for one field definition. Exactly one of
/// textValue/numberValue/dateValue/booleanValue/optionId is populated,
/// chosen by `definition.type` — same single-table-per-type-column shape as
/// ProjectPropertyValue.
model KnowledgeFieldValue {
  id String @id @default(uuid())

  textValue    String?
  numberValue  Float?
  dateValue    DateTime?
  booleanValue Boolean?

  optionId String?
  option   KnowledgeFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  itemId String
  item   KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  definitionId String
  definition   KnowledgeFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([itemId, definitionId])
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

/// One AI call's usage/cost — currently only 知識庫's Gemini calls log here,
/// but `feature` is a plain string (not an enum) so any future AI feature
/// can reuse this same table instead of growing a parallel one. Visible
/// only to the user themselves (see AiUsageService) — this is personal
/// spend tracking, not a platform-wide admin report.
model AiUsageLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String // e.g. "knowledge"
  model   String // e.g. "gemini-2.5-flash"

  inputTokens  Int
  outputTokens Int
  costUsd      Float
  durationMs   Int

  status       AiUsageStatus
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
