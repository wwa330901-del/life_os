// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SpaceType {
  PERSONAL
  CALENDAR
}

enum PropertyType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum FinanceAccountType {
  CASH
  BANK
  CREDIT_CARD
  OTHER
}

enum FinanceCategoryKind {
  INCOME
  EXPENSE
}

/// LOAN_OUT/LOAN_IN and ADVANCE_OUT/ADVANCE_IN move real cash in/out of a
/// FinanceAccount (computeBalanceDeltas must handle them) but are
/// deliberately excluded from every 收入/支出 aggregation (monthlySummary,
/// budgets, home dashboard, AI 問答 tools) — those all filter on an
/// INCOME/EXPENSE allowlist, so a new type here is excluded automatically
/// without needing to touch that filtering logic. Same reasoning as
/// TRANSFER: money moved, but it isn't real income or spending.
enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  LOAN_OUT
  LOAN_IN
  ADVANCE_OUT
  ADVANCE_IN
}

enum FinanceLoanDirection {
  LEND
  BORROW
}

/// How a 定期交易 whose trigger date lands on a holiday (weekend or Taiwan
/// government holiday) should shift: not at all, to the nearest earlier
/// working day, or to the nearest later working day.
enum FinanceRecurringHolidayAdjustment {
  NONE
  EARLIER
  LATER
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Null for accounts created via Google sign-in that never set a password.
  passwordHash String?

  // Null until the registration email's code is confirmed. Google sign-in
  // sets this immediately (Google already verified the address).
  emailVerifiedAt           DateTime?
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  // Null unless the account is linked to (or was created via) Google sign-in.
  googleId String? @unique

  // Platform-wide admin: can manage all accounts.
  isPlatformAdmin Boolean @default(false)

  /// This user's own Gemini API key (aistudio.google.com), used for their
  /// own 知識庫 AI analysis so usage bills to their own Google account, not
  /// a shared platform-wide key. Null = feature unusable for them (no
  /// fallback to any shared key, by explicit design). Plain column, same
  /// as this schema's other third-party secrets (e.g.
  /// GoogleCalendarConnection.refreshToken) — Postgres access itself is
  /// the trust boundary.
  geminiApiKey String?

  /// 算命用的生辰（2026-10-01）：日期必填、時間可以不知道。
  birthDate DateTime? @db.Date
  birthTime String?

  /// 健康（2026-10-01）：iPhone 捷徑自動上傳睡眠/步數/體重用的私人金鑰
  /// （POST /health/ingest 帶 Authorization: Bearer <這個>），App 可重新產生。
  healthIngestToken String? @unique

  /// This user's 首頁 widget layout — which widgets are shown and in what
  /// order, e.g. `{ widgets: [{ type: "personalFinance", visible: true },
  /// ...] }`. Null means "use the default layout" (all widgets, default
  /// order) rather than an empty list meaning "hide everything", so a
  /// brand-new widget added in a future release still shows up for
  /// existing users instead of silently staying hidden until they touch
  /// the settings themselves. Server-side (not local-only) so it survives
  /// a reinstall/new machine, same as every other piece of user data.
  homeLayoutConfig Json?

  personalSpace              Space?                     @relation("PersonalSpaceOwner")
  calendarSpace              Space?                     @relation("CalendarSpaceOwner")
  lineAccountLink            LineAccountLink?
  appAiSession               AppAiSession?
  journalEntries             JournalEntry[]
  divinations                DivinationRecord[]
  healthRecords              HealthRecord[]
  memories                   UserMemory[]
  importantDates             ImportantDate[]
  personalTodos              ProjectTodo[]              @relation("TodoPersonalOwner")
  googleCalendarConnections  GoogleCalendarConnection[]
  appleCalendarConnections   AppleCalendarConnection[]
  knowledgeCategories        KnowledgeCategory[]
  knowledgeItems             KnowledgeItem[]
  aiUsageLogs                AiUsageLog[]
  calendarSharesGiven        CalendarShare[]            @relation("CalendarShareOwner")
  calendarSharesReceived     CalendarShare[]            @relation("CalendarShareViewer")
  financeLoanInvitesSent     FinanceLoanInvite[]        @relation("LoanInviteFrom")
  financeLoanInvitesReceived FinanceLoanInvite[]        @relation("LoanInviteTo")
  friendshipsRequested       Friendship[]               @relation("FriendshipRequester")
  friendshipsReceived        Friendship[]               @relation("FriendshipAddressee")
  lifeGoals                  LifeGoal[]
}

/// 好友 (2026-08-06) — a mutual, symmetric relationship: unlike CalendarShare
/// or FinanceLoanInvite (directional, owner grants viewer/counterpart
/// something), neither side of an accepted friendship has more standing
/// than the other. Still stored as one directional row (`requesterUserId`
/// sent the invite, `addresseeUserId` received it) purely so a "sent" vs
/// "received" pending-invite screen can tell them apart — that direction
/// stops mattering the moment `accepted` flips true. Same "no tombstone"
/// convention as every other invite in this schema: declining, revoking, or
/// unfriending is always a plain delete, never a status flag; re-adding
/// later is a fresh row. `FriendsService.invite` checks BOTH directions
/// before creating a row — the `@@unique` below only blocks the exact same
/// direction being inserted twice, not the reverse pair, so the service is
/// what actually prevents A→B and B→A coexisting.
///
/// This is the prerequisite for 共用行事曆/借出借入互通's invite flows
/// (2026-08-06 onward) — both now require an accepted Friendship first and
/// pick the target from the friend list instead of typing an email raw.
model Friendship {
  id String @id @default(uuid())

  requesterUserId String
  requester       User   @relation("FriendshipRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  addresseeUserId String
  addressee       User   @relation("FriendshipAddressee", fields: [addresseeUserId], references: [id], onDelete: Cascade)

  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([requesterUserId, addresseeUserId])
}

model Space {
  id        String    @id @default(uuid())
  type      SpaceType
  name      String
  createdAt DateTime  @default(now())

  // Only set when type = PERSONAL. Each user has exactly one personal space.
  ownerUserId String? @unique
  owner       User?   @relation("PersonalSpaceOwner", fields: [ownerUserId], references: [id])

  // Only set when type = CALENDAR. Each user has at most one calendar space
  // — a separate 1:1-per-user slot from the personal space above (a user
  // can have both), created on demand rather than at signup.
  calendarOwnerUserId String? @unique
  calendarOwner       User?   @relation("CalendarSpaceOwner", fields: [calendarOwnerUserId], references: [id])

  financeAccounts              FinanceAccount[]
  financeCategories            FinanceCategory[]
  financeTransactions          FinanceTransaction[]
  financeBudgets               FinanceBudget[]
  financeRecurringTransactions FinanceRecurringTransaction[]
  financeLoans                 FinanceLoan[]
  financeAdvances              FinanceAdvance[]
  calendarEvents               CalendarEvent[]
  googleCalendarConnection     GoogleCalendarConnection?
  appleCalendarConnection      AppleCalendarConnection?
  stockTransactions            StockTransaction[]
  stockRecurringInvestments    StockRecurringInvestment[]
  stockHoldings                StockHolding[]
  financeNetWorthSnapshots     FinanceNetWorthSnapshot[]
}

/// One event on a CALENDAR space's calendar.
model CalendarEvent {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  title    String
  location String?
  notes    String?
  startAt  DateTime
  endAt    DateTime?
  allDay   Boolean   @default(false)

  /// Google Calendar's event id, once pushed/pulled — null means either
  /// "not yet synced" or "this space has no Google connection".
  googleEventId String?

  /// iCloud CalDAV 行事曆匯入 (2026-08-10) — 這則事件的 iCloud UID，null 代表
  /// 不是從 iCloud 匯入的。跟 googleEventId 不同的是這條同步永遠是單向
  /// （iCloud → 元序，見 AppleCalendarSyncService），改這裡的事件絕不會被
  /// 推回 iCloud，所以不需要對應的 push 邏輯。iCloud 的重複行程（RRULE）
  /// 在匯入時就展開成一筆一筆獨立的未來 90 天內事件（每次 5 分鐘同步都會
  /// 往前滾動延伸），不會用 CalendarEvent 自己的 recurrenceFrequency 系統
  /// 表示——兩種重複規則格式落差太大，硬轉換容易失真，展開成具體事件
  /// 更可靠、也更容易在 iCloud 那邊改掉單一次時偵測到差異。
  appleEventUid String?

  /// 使用者在元序新增時選的「要存到哪」(2026-09-30：一定要選 Google 或
  /// iPhone，不選不能新增)。null＝這個功能之前的舊資料，維持舊行為（Google
  /// 有連就推過去，iCloud 匯入的不推）。從 Google/iCloud 同步進來的事件也會
  /// 記上各自的來源，之後在元序改它就改回原本那一邊。
  syncTarget CalendarSyncTarget?

  /// iCloud 那邊這則事件的 CalDAV 物件網址＋etag——改/刪要回寫 iCloud 用。
  /// 只有單一事件有；iCloud 重複行程展開出來的每一次（uid 含 "::"）沒有，
  /// 那種只能到 iPhone 上改。
  appleEventHref String?
  appleEventEtag String?

  /// Set only for an event TodosService auto-created from a todo's due
  /// date/time (one-way 代辦事項→行事曆 sync, 2026-08-05 — the reverse
  /// direction is deliberately not a thing, editing this event directly
  /// never writes back to the todo). onDelete: Cascade here means deleting
  /// the source ProjectTodo takes this event with it as a DB-level
  /// safety net, but TodosService.remove also explicitly calls
  /// CalendarEventsService.remove first so the Google-side delete actually
  /// fires (a raw cascade delete wouldn't reach Google).
  sourceTodoId String?      @unique
  sourceTodo   ProjectTodo? @relation("TodoSyncedEvent", fields: [sourceTodoId], references: [id], onDelete: Cascade)

  /// 行事曆循環事件 (2026-08-05) — NONE means a plain one-off event (unchanged
  /// behavior). Anything else makes this row a SERIES definition rather than
  /// a single occurrence: occurrences are generated on the fly for whatever
  /// date range is being queried (see calendar-recurrence.ts), never
  /// materialized as their own rows, except where a `CalendarEventException`
  /// records a deviation. `recurrenceUntil` null means "repeats forever";
  /// non-null is inclusive (the occurrence ON that date is still included).
  /// A series never gets pushed to Google Calendar (see
  /// CalendarEventsService.pushToGoogleInBackground/CalendarSyncService) —
  /// out of scope for this round, `googleEventId` stays null on these rows.
  recurrenceFrequency CalendarRecurrenceFrequency @default(NONE)
  recurrenceUntil     DateTime?

  exceptions CalendarEventException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, googleEventId])
  @@unique([spaceId, appleEventUid])
  @@index([spaceId, startAt])
}

enum CalendarRecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// Per-occurrence deviation from a recurring CalendarEvent's generated
/// pattern — see the doc comment on `CalendarEvent.recurrenceFrequency` for
/// how occurrences are generated, and `CalendarEventsService.
/// updateOccurrence`/`removeOccurrence` for how the three edit scopes
/// (只改這次／這次以後／全部) map onto this table:
/// - 只改這次 (THIS) — upserts a row here (`cancelled: false` + override
///   fields for an edit, `cancelled: true` for a delete). Every other field
///   stays null when cancelled.
/// - 這次以後 (FOLLOWING) — never touches this table for the split point
///   itself; truncates the original series' `recurrenceUntil` and (for an
///   edit) creates a brand new CalendarEvent series starting there. Only
///   reparents (or removes) exceptions dated on/after the split.
/// - 全部 (ALL) — edits the series row directly, doesn't touch exceptions.
model CalendarEventException {
  id       String        @id @default(uuid())
  seriesId String
  series   CalendarEvent @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// Which generated occurrence this overrides, as that occurrence's own
  /// Taipei calendar date (midnight UTC of that day — see
  /// taipeiDateKeyToUtc()), NOT the series' own start date.
  occurrenceDate DateTime @db.Date

  cancelled Boolean   @default(false)
  title     String?
  startAt   DateTime?
  endAt     DateTime?
  allDay    Boolean?
  location  String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, occurrenceDate])
}

/// A CALENDAR space's link to one Google Calendar (always the connecting
/// user's "primary" calendar for now — no per-space calendar picker yet).
/// `refreshToken` follows this codebase's existing pattern of storing
/// third-party secrets as plain columns (no field-level encryption anywhere
/// else in this schema either) — Postgres access itself is the trust
/// boundary. `syncToken` is Google's incremental-sync cursor; null forces a
/// full resync (e.g. right after connecting, or if Google invalidates it).
model GoogleCalendarConnection {
  id      String @id @default(uuid())
  spaceId String @unique
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  syncToken            String?
  lastSyncedAt         DateTime?

  connectedByUserId String
  connectedBy       User   @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A CALENDAR space's link to one iCloud (CalDAV) account (2026-08-10) —
/// deliberately read-only/pull-only, unlike GoogleCalendarConnection which
/// also pushes local events out. `appPassword` is an Apple "App-Specific
/// Password" (iCloud requires 2FA account-wide, so a real account password
/// can't be used for API access) — same "plain column, DB access is the
/// trust boundary" convention as every other third-party secret in this
/// schema. `selectedCalendarUrls` are the specific CalDAV calendar
/// collection URLs (out of everything visible under this Apple ID,
/// including calendars shared TO this account by someone else — iCloud
/// handles sharing server-side, so an accepted shared calendar just shows
/// up as one more entry in this account's own calendar list, no special
/// handling needed) the user picked to actually sync in — connecting
/// doesn't mean "sync everything".
model AppleCalendarConnection {
  id      String @id @default(uuid())
  spaceId String @unique
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  appleId              String
  appPassword          String
  selectedCalendarUrls String[]
  /// 元序新增「存到 iPhone」的行程寫進哪一個 iCloud 日曆。null＝selectedCalendarUrls 的第一個。
  writeCalendarUrl     String?
  lastSyncedAt         DateTime?

  connectedByUserId String
  connectedBy       User   @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// See CalendarEvent.syncTarget.
enum CalendarSyncTarget {
  GOOGLE
  ICLOUD
}

enum CalendarShareDetailLevel {
  FULL
  BUSY_ONLY
}

/// 共用行事曆 (2026-08-05) — `ownerUserId` invites `viewerUserId` by email to
/// see their calendar overlaid on the viewer's own 共用行事曆 view.
/// Deliberately not modeled as a `Space` membership — this isn't "join my
/// calendar space", it's a one-directional, revocable viewing grant that
/// doesn't let the viewer edit anything. `accepted` starts false (a plain
/// invite) and only ever flips true once, by the viewer's own action —
/// there's no "declined" state, a decline (or a later revoke/remove) just
/// deletes the row outright rather than tombstoning it (re-inviting later
/// should feel like a fresh invite, not a resurrection). `detailLevel` is
/// the owner's call (it's their information being exposed) and can be
/// changed any time, not just at invite creation; `viewerColor` is the
/// opposite — purely the viewer's own display preference for
/// distinguishing whose events are whose on their combined view, the owner
/// has no say in it.
model CalendarShare {
  id String @id @default(uuid())

  ownerUserId String
  owner       User   @relation("CalendarShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  viewerUserId String
  viewer       User   @relation("CalendarShareViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)

  accepted    Boolean                  @default(false)
  detailLevel CalendarShareDetailLevel @default(FULL)

  /// Hex color, e.g. "#5B8DEF" — no enum/palette table, just a free string
  /// the App's color picker writes.
  viewerColor String @default("#5B8DEF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, viewerUserId])
}

/// First 個人功能 module: a personal-space money container (現金/銀行/信用卡/
/// 其他), 記帳系統's "帳戶". Balance is derived (initialBalance plus every
/// transaction against it, including transfers in/out) rather than stored,
/// so it never drifts out of sync with the transaction log.
model FinanceAccount {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name           String
  type           FinanceAccountType
  initialBalance Float              @default(0)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  /// 信用卡（2026-10-01）：結帳日、繳款日（1-31，月底不足就用月底）、
  /// 扣款帳戶（同一個空間的帳戶 id）、自動扣繳（繳款日自動記一筆轉帳）。
  /// cardReminderKey 記最後一次提醒（「繳款日:剩幾天」），同一則不重發。
  statementDay     Int?
  paymentDueDay    Int?
  paymentAccountId String?
  cardAutoPay      Boolean @default(false)
  cardReminderKey  String?

  transactions FinanceTransaction[] @relation("AccountTransactions")
  transfersIn  FinanceTransaction[] @relation("TransferToAccount")

  recurringAsSource FinanceRecurringTransaction[] @relation("RecurringSourceAccount")
  recurringAsTarget FinanceRecurringTransaction[] @relation("RecurringToAccount")

  stockTransactions         StockTransaction[]
  stockRecurringInvestments StockRecurringInvestment[]

  lifeGoals LifeGoal[]
}

/// A 記帳 category (收入/支出), user-managed per personal space from day
/// one — no platform-wide fixed list, same "each space owns its own"
/// pattern as ProjectPropertyDefinition.
model FinanceCategory {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name      String
  kind      FinanceCategoryKind
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  // 母分類/子分類 — exactly two levels (a category with a parentId can't
  // itself have children; enforced in application code, not the DB). Null
  // parentId = 母分類. A 母分類 with at least one child can't be used
  // directly on a transaction anymore — the child is the specific
  // classification, the parent is just the rollup grouping shown in
  // 總覽/報表/預算 (see FinanceTransaction.categoryId comment). A parent
  // with zero children stays directly usable, unchanged from before this
  // feature existed.
  parentId String?
  parent   FinanceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children FinanceCategory[] @relation("CategoryHierarchy")

  transactions          FinanceTransaction[]
  budget                FinanceBudget?
  recurringTransactions FinanceRecurringTransaction[]

  @@unique([spaceId, name, kind, parentId])
}

model FinanceTransaction {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  type   FinanceTransactionType
  amount Float

  accountId String
  account   FinanceAccount @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  // Only set for `type = TRANSFER` — the other side of the money movement.
  toAccountId String?
  toAccount   FinanceAccount? @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  // Null for TRANSFER; required for INCOME/EXPENSE.
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Date-only, no time-of-day.
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  // The following four are each set on exactly one row — the one
  // FinanceTransaction that represents a 借貸/代墊's *initial* cash move, or
  // one that represents a single repayment against it. Deliberately no
  // duplicated amount/date/account/note on FinanceLoan*/FinanceAdvance*
  // themselves — this transaction row is the single source of truth for
  // those, same "derive, don't duplicate" preference as FinanceAccount's
  // balance. onDelete: Cascade is defined here (the child) so deleting the
  // parent FinanceLoan/FinanceLoanRepayment/etc. also removes this row.
  financeLoanId String?      @unique
  financeLoan   FinanceLoan? @relation("LoanInitialTransaction", fields: [financeLoanId], references: [id], onDelete: Cascade)

  loanRepaymentId String?               @unique
  loanRepayment   FinanceLoanRepayment? @relation(fields: [loanRepaymentId], references: [id], onDelete: Cascade)

  financeAdvanceId String?         @unique
  financeAdvance   FinanceAdvance? @relation("AdvanceInitialTransaction", fields: [financeAdvanceId], references: [id], onDelete: Cascade)

  advanceRepaymentId String?                  @unique
  advanceRepayment   FinanceAdvanceRepayment? @relation(fields: [advanceRepaymentId], references: [id], onDelete: Cascade)

  @@index([spaceId, date])
}

/// 跟人借錢/借錢給人 — a lightweight "receivable/payable" ledger, deliberately
/// separate from 代墊 even though the underlying mechanic (cash moves now,
/// settles later, never counted as real income/expense) is identical, per
/// explicit user choice ("完全分開做兩個獨立功能"). `direction` decides which
/// way both the initial transaction and every repayment's cash flows:
/// LEND → initial LOAN_OUT, repayments are LOAN_IN (money comes back);
/// BORROW → initial LOAN_IN, repayments are LOAN_OUT (money goes back out).
/// "Outstanding"/"settled" is always derived (initialTransaction.amount
/// minus the sum of repayments' transaction amounts), never stored.
model FinanceLoan {
  id               String               @id @default(uuid())
  spaceId          String
  space            Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  direction        FinanceLoanDirection
  // 跟誰借/借給誰 — free text, no contacts system.
  counterpartyName String
  createdAt        DateTime             @default(now())

  /// 大系統V1.54.0 — persisted mirror of `outstanding <= 0`, kept in sync by
  /// `FinanceLoansService` on every write that can change the outstanding
  /// balance (create/addRepayment/update/updateRepayment/acceptInvite).
  /// Exists so `list()` can filter `WHERE settled = ...` at the query level
  /// for cursor pagination — an old unsettled loan must always land on page
  /// 1 of the "未結清" view regardless of `createdAt`, which a purely
  /// in-memory-computed `settled` (the old approach) can't guarantee once
  /// the list is paginated instead of loaded whole.
  settled Boolean @default(false)

  initialTransaction FinanceTransaction?    @relation("LoanInitialTransaction")
  repayments         FinanceLoanRepayment[]

  /// This loan sent a 借出/借入互通 invite to another platform user (set at
  /// most once — `FinanceLoanInvite.fromLoanId` is `@unique`).
  inviteSent    FinanceLoanInvite? @relation("LoanInviteSource")
  /// This loan WAS the counterpart record auto-created when someone else's
  /// invite got accepted (set only on the mirrored side).
  inviteCreated FinanceLoanInvite? @relation("LoanInviteCreatedLoan")
}

/// 借出/借入互通 (2026-08-05) — inviting another platform user to confirm a
/// loan you recorded involving them, so their side automatically gets a
/// matching record instead of relying on them to type it in themselves.
/// **Requires their acceptance** (explicit user requirement, same
/// consent-based pattern as CalendarShare) — nothing is created on
/// `toUserId`'s side until `accepted` flips true. Deliberately a one-time
/// mirror at acceptance, not an ongoing sync: once `createdLoanId` is set,
/// the two `FinanceLoan` rows are independent going forward (each side's
/// own repayments are tracked separately, not pushed to the other) — the
/// user only asked for "the other side gets one matching record", not
/// continuous two-way sync.
model FinanceLoanInvite {
  id String @id @default(uuid())

  fromLoanId String      @unique
  fromLoan   FinanceLoan @relation("LoanInviteSource", fields: [fromLoanId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("LoanInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("LoanInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  accepted Boolean @default(false)

  createdLoanId String?      @unique
  createdLoan   FinanceLoan? @relation("LoanInviteCreatedLoan", fields: [createdLoanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model FinanceLoanRepayment {
  id        String      @id @default(uuid())
  loanId    String
  loan      FinanceLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  transaction FinanceTransaction?
}

/// 工作上先幫忙出錢，之後還你 — see FinanceLoan's doc comment for why
/// this is a separate model rather than sharing one with a "purpose" field.
/// Always one-directional (advance out, then reimbursed in — there's no
/// "borrow" equivalent), so unlike FinanceLoan there's no direction field:
/// the initial transaction is always ADVANCE_OUT, every repayment is
/// always ADVANCE_IN.
model FinanceAdvance {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // 說明/事由，例如「材料款」— just a free-text label for what this advance was for.
  title     String
  createdAt DateTime @default(now())

  /// See `FinanceLoan.settled`'s doc comment — same reasoning/sync pattern,
  /// kept up to date by `FinanceAdvancesService`.
  settled Boolean @default(false)

  initialTransaction FinanceTransaction?       @relation("AdvanceInitialTransaction")
  repayments         FinanceAdvanceRepayment[]
}

model FinanceAdvanceRepayment {
  id        String         @id @default(uuid())
  advanceId String
  advance   FinanceAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  transaction FinanceTransaction?
}

/// Standing monthly spending target per category — compared against that
/// month's actual FinanceTransaction total when the user looks at a given
/// month, not itself tied to one specific month (applies every month until
/// changed).
model FinanceBudget {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  categoryId    String          @unique
  category      FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyAmount Float

  createdAt DateTime @default(now())
}

/// 財務分析報表的淨資產趨勢 (2026-08-06) — one row per (space, Taipei
/// calendar day), written by a daily cron (`FinanceReportService.
/// snapshotAllSpaces`) AND self-healed on read (`FinanceReportService.
/// getReport` upserts today's row if it's missing, same "backfill on next
/// access" philosophy as `StocksHoldingsService`/`FinanceCategoriesService`
/// elsewhere in this schema) — there's no way to reconstruct PAST net
/// worth after the fact (account balances/holdings aren't versioned), so
/// the trend can only ever start accruing from whenever this feature first
/// ran for that space, never backfilled earlier than that.
model FinanceNetWorthSnapshot {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  date             DateTime @db.Date
  totalAssets      Float
  totalLiabilities Float
  netWorth         Float

  createdAt DateTime @default(now())

  @@unique([spaceId, date])
}

/// A recurring 記帳 entry — the credit-card-bill use case: "every month on
/// day N, do something". `amount` is optional: set it for a fixed
/// recurring amount (rent, subscriptions) and the due day auto-creates the
/// FinanceTransaction plus a LINE notification saying so; leave it blank
/// for a variable amount (a credit card bill that's a different number
/// every month) and the due day just sends a LINE reminder — no
/// transaction gets created, the user records the real amount themselves.
model FinanceRecurringTransaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  type   FinanceTransactionType
  amount Float?
  note   String?

  /// 1-31. If the current month has fewer days than this, triggers on the
  /// month's actual last day instead (e.g. 31 in February triggers on the
  /// 28th/29th).
  dayOfMonth Int

  /// If the resulting date this month falls on a weekend or Taiwan
  /// government holiday, whether to fire early/late instead — checked
  /// against the same `isTaiwanHoliday` calendar used by 工期表 scheduling.
  holidayAdjustment FinanceRecurringHolidayAdjustment @default(NONE)

  active Boolean @default(true)

  accountId String
  account   FinanceAccount @relation("RecurringSourceAccount", fields: [accountId], references: [id], onDelete: Cascade)

  /// Only set for `type = TRANSFER` — the other side of the money movement.
  toAccountId String?
  toAccount   FinanceAccount? @relation("RecurringToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  /// Null for TRANSFER; only meaningful for INCOME/EXPENSE.
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// "YYYY-MM" of the last month this already fired in — stops the daily
  /// cron from double-firing if it runs more than once on the trigger day.
  lastTriggeredMonth String?
}

enum StockTransactionType {
  BUY
  SELL
}

/// A manually-entered stock buy/sell (personal-space 投資 module). `tradeDate`
/// is just the date it's registered on — the actual money movement doesn't
/// happen until `settlementDate` (tradeDate + 2 trading days, matching
/// Taiwan's real T+2 settlement), when `StockSettlementService`'s daily cron
/// creates the real FinanceTransaction and flips `settled`. Users provide
/// `pricePerShare` and `totalCost`; `shares` is derived (`totalCost /
/// pricePerShare`) so nobody has to do that math themselves — same
/// convention used by StockRecurringInvestment's DCA fill-ins.
model StockTransaction {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  stockCode String
  type      StockTransactionType

  pricePerShare Float
  totalCost     Float
  shares        Float

  tradeDate      DateTime @db.Date
  settlementDate DateTime @db.Date
  settled        Boolean  @default(false)

  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime @default(now())

  /// 定期定額到期自動先建的「待填成交價」交易 (2026-08-12) — true 期間
  /// pricePerShare/shares 是佔位值（0），totalCost 是計畫設定的每期預計
  /// 金額（還不是真的成交金額）。每個實際會動用這些欄位的地方（持股
  /// recompute、交割排程）都要記得排除 pending:true，避免拿佔位資料去
  /// 算平均成本或誤交割。回覆成交價（LINE 或 App）之後就地更新這一列
  /// （不是另外新建一筆），翻成 pending:false 並直接完成交割——見
  /// StocksRecurringService.doFulfill 的「T（不等 T+2）立即扣款」設計。
  pending Boolean @default(false)

  /// 只有 pending 由定期定額計畫自動建立的那一列才會有值，讓回覆成交價
  /// 時能直接用外鍵找到「這一筆」，不用靠猜日期/代碼去配對。
  recurringInvestmentId String?
  recurringInvestment   StockRecurringInvestment? @relation(fields: [recurringInvestmentId], references: [id], onDelete: SetNull)

  @@index([spaceId, stockCode])
  @@index([settlementDate, settled])
}

/// 定期定額（DCA）計畫 — same "每月第幾天＋遇假日調整" shape as
/// FinanceRecurringTransaction, but the amount is never fixed (a DCA fill
/// price varies every round), so the daily cron only ever sends a LINE
/// reminder, never auto-creates a transaction. `awaitingReply` is what lets
/// LineService tell a plain "股票代碼 成交價 投入成本" reply apart from a
/// regular 記帳/代辦 command — see `tryStockDcaReply`.
model StockRecurringInvestment {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  stockCode         String
  dayOfMonth        Int
  holidayAdjustment FinanceRecurringHolidayAdjustment @default(NONE)

  /// 每期預計投入的金額 (2026-08-12) — 到期時使用者只需要回覆成交價，
  /// 系統用「這個金額 ÷ 成交價」無條件捨去算出買得起的整股數，再回推
  /// 實際花費（可能略低於這個金額，因為股票只能整股買，捨去的零頭沒有
  /// 花掉）。Nullable 只是為了不讓這個欄位新增時破壞既有資料列——新建立
  /// 的計畫一律要求填寫（見 CreateStockRecurringInvestmentDto），既有的
  /// 舊計畫在使用者下次編輯儲存前都不會觸發提醒（見
  /// StocksRecurringService.sendDueReminders 的 null 檢查）。
  monthlyAmount Float?

  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  active             Boolean @default(true)
  lastTriggeredMonth String?
  awaitingReply      Boolean @default(false)

  createdAt DateTime @default(now())

  transactions StockTransaction[]
}

/// Stock price cache — one row per stock code, shared across every space
/// (price data is public, not user-specific). `dailyClosePrice` is updated
/// once after market close via TWSE's official free OpenAPI
/// (STOCK_DAY_ALL); `intradayPrice` is opportunistically refreshed every
/// few minutes during trading hours via TWSE's unofficial realtime feed —
/// that feed isn't a published/versioned contract, so a fetch failure just
/// leaves the last known value in place (UI falls back to
/// `dailyClosePrice`) rather than erroring.
/// 持股快取 (2026-08-05) — the average-cost-basis running total per
/// (space, stockCode), replacing what used to be recomputed from this
/// space's ENTIRE stock trade history on every single holdings read (same
/// class of problem as the 知識庫/代辦事項 unbounded-query fixes, except
/// here the fix can't be "just paginate" — average-cost-basis is
/// order-dependent, see `StocksHoldingsService`'s doc comment for the
/// hand-verified proof). `StocksTransactionsService.create` /
/// `StocksRecurringService.fulfillPendingReply` update this incrementally
/// (cheap: one BUY/SELL delta, no history scan); `update`/`remove` on an
/// existing transaction instead trigger a full recompute scoped to just
/// that one stockCode (rare — edits/deletes aren't the hot path — and
/// still far cheaper than the old "recompute every code in the space").
/// Deleted outright once `shares` rounds to ~0 rather than left at zero,
/// so `StocksHoldingsService.list` can just return every row unfiltered.
model StockHolding {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  stockCode String
  shares    Float
  costBasis Float

  updatedAt DateTime @updatedAt

  @@unique([spaceId, stockCode])
}

model StockPriceCache {
  stockCode String  @id
  stockName String?

  dailyClosePrice Float?
  dailyCloseDate  DateTime? @db.Date

  intradayPrice     Float?
  intradayUpdatedAt DateTime?

  updatedAt DateTime @updatedAt
}

/// Links a life_os user to their LINE account, so a message sent to the
/// 記帳 LINE bot knows whose personal space to record a transaction
/// against. Two states in one row rather than two tables: `linkCode` set +
/// `lineUserId` null means "waiting for the user to send this code from
/// LINE"; `lineUserId` set means linking is complete (`linkCode` cleared).
model LineAccountLink {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lineUserId        String?   @unique
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?

  /// The ordered ProjectTodo ids from the last "代辦事項"/"代辦事項總覽" list
  /// shown to this LINE user — lets "完成 2" reference an item by the
  /// number printed next to it instead of retyping its title (titles typed
  /// when completing something often don't match what was typed when it
  /// was created). Overwritten every time either list is (re-)shown;
  /// numbers don't shift after a completion within the same shown list.
  lastTodoListIds String[] @default([])

  /// Same numbered-list-reference pattern as `lastTodoListIds`, one each
  /// for 借貸/代墊 since "借貸列表"/"代墊列表" are two separate lists — lets
  /// "還款 2 1000"/"收回代墊 2 1000" reference an item by number.
  lastLoanListIds    String[] @default([])
  lastAdvanceListIds String[] @default([])

  /// Set while a KnowledgeItem is AWAITING_CATEGORY_DECISION and this user
  /// has just been asked "建議新增 XX 分類" — their next plain-text reply
  /// ("新增" or an existing category name) resolves this specific item,
  /// same single-pending-slot pattern as StockRecurringInvestment.awaitingReply.
  pendingKnowledgeItemId String?

  /// Set to "美食"/"景點" right after the user taps that LINE rich-menu
  /// button — their next plain-text message is treated as the location to
  /// search, not a new command.
  pendingKnowledgeLocationQueryCategory String?

  /// Set after the user replies "安排" to an 展覽資訊 ending-soon reminder —
  /// their next plain-text reply is parsed as the date/time to schedule,
  /// which then creates the CalendarEvent + ProjectTodo for this item.
  pendingExhibitionScheduleItemId String?

  /// LINE 萬用 AI（2026-09-30）的上一輪 interaction id + 時間——AI 反問
  /// （「存到 Google 還是 iPhone？」「記在哪個帳戶？」）時，下一則訊息接著同
  /// 一段對話，10 分鐘後失效。
  aiInteractionId String?
  aiInteractionAt DateTime?

  /// AI 提議、等使用者確認才執行的動作（猜的記帳帳戶、自動排的行程）。
  /// `pendingAiActionTurn` 記下提議時是哪一則訊息——確認一定要來自之後的
  /// 另一則訊息，AI 不能自己提議又自己確認。
  pendingAiAction     Json?
  pendingAiActionTurn String?

  /// 日記（2026-10-01）：每晚 21:30 沒寫日記就問一句「今天過得怎樣？」，
  /// 記下問的時間——之後 3 小時內的回覆交給 AI 記成日記。
  journalPromptAt        DateTime?
  journalReminderEnabled Boolean   @default(true)
  /// 每日早報（2026-10-01）：每天 08:00 今天的行程/代辦/昨天花費/預算，傳「關閉早報」可關。
  morningBriefEnabled    Boolean   @default(true)
  /// App「提醒設定」（2026-10-01）：有時間的代辦前 1 小時、週/月回顧、人生目標到期/太久沒更新。
  todoReminderEnabled    Boolean   @default(true)
  reviewEnabled          Boolean   @default(true)
  goalReminderEnabled    Boolean   @default(true)
  /// 算命回饋：LINE 剛問過哪一筆算命準不準——24 小時內的回覆交給 AI 記成回饋。
  divinationFeedbackId   String?
  divinationFeedbackAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A personal to-do item, owned directly by its creator. Model name kept as
/// ProjectTodo (not renamed) — this table used to also carry company-space
/// project todos (`projectId`) before the company-space split; that column
/// is gone, only the personal-owner path remains.
model ProjectTodo {
  id String @id @default(uuid())

  personalOwnerUserId String?
  personalOwner       User?   @relation("TodoPersonalOwner", fields: [personalOwnerUserId], references: [id], onDelete: Cascade)

  title       String
  done        Boolean   @default(false)
  completedAt DateTime?

  /// Every todo must have exactly one of dueDate/isOngoing set going
  /// forward (enforced in TodosService, not a DB constraint — a plain
  /// NOT NULL/CHECK would also reject the pre-existing rows that predate
  /// this rule (2026-08-03), which the user explicitly wants left alone
  /// rather than force-backfilled). isOngoing = a deliberate "no fixed
  /// date, recurring/persistent task" marker — distinct from just leaving
  /// dueDate empty, which is why it's its own flag rather than dueDate
  /// staying implicitly optional.
  /// 2026-08-05: widened from date-only to a full timestamp so a todo can
  /// optionally carry a time-of-day, same as CalendarEvent — existing rows
  /// keep reading back as UTC-midnight-of-that-date (unchanged meaning,
  /// just a wider column type), `dueDateAllDay` (default true, matching
  /// every pre-existing row's actual "no time" reality) is the
  /// CalendarEvent.allDay equivalent that says whether the time component
  /// means anything.
  dueDate            DateTime?
  dueDateAllDay      Boolean             @default(true)
  isOngoing          Boolean             @default(false)
  /// 有日期的代辦會自動在行事曆產生一筆——那筆要存到 Google 還是 iPhone
  /// （2026-09-30：跟代辦一起選，規則同 CalendarEvent.syncTarget）。
  calendarSyncTarget CalendarSyncTarget?
  priority           TodoPriority        @default(MEDIUM)
  /// 有時間的代辦到期前 1 小時 LINE 提醒過了（2026-10-01）；改到期時間會清掉重來。
  dueReminderSentAt  DateTime?
  notes              String?

  /// The auto-created 行事曆 event mirroring this todo's due date/time, if
  /// any — see CalendarEvent.sourceTodoId for the full sync explanation.
  syncedCalendarEvent CalendarEvent? @relation("TodoSyncedEvent")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personalOwnerUserId])
}

enum KnowledgeItemStatus {
  PENDING
  PROCESSING
  AWAITING_CATEGORY_DECISION
  DONE
  FAILED
}

/// Only meaningful when the item's category is 展覽資訊 — tracks whether the
/// "快結束了還沒去" LINE reminder has been answered yet, so the daily cron
/// doesn't keep re-asking once the user has already said 安排 or 不安排.
/// This is workflow state the automation itself manages, not a user-defined
/// field, which is why it's a fixed column instead of living in
/// KnowledgeFieldValue like 是否已觀展/結束日期 do.
enum KnowledgeExhibitionDecisionStatus {
  PENDING
  SCHEDULED
  CANCELLED
}

/// One knowledge-collection category a user has defined for themselves —
/// e.g. 美食/景點/展覽資訊 — independent module, not scoped to any Space
/// (見 大系統 doc: 知識庫 is account-level, not personal/calendar).
/// Sharing is at this granularity (a whole category, not per-item): making
/// a category public exposes every item under it — present and future — to
/// every other account on the platform except whoever's in `blacklistedUserIds`.
model KnowledgeCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  isPublic           Boolean  @default(false)
  blacklistedUserIds String[] @default([])

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  fields KnowledgeFieldDefinition[]
  items  KnowledgeItem[]

  @@unique([ownerUserId, name])
}

/// One custom field a category's owner has defined for it (e.g. 美食's
/// 店名/地址/評價) — each owner defines their own columns, scoped to a
/// KnowledgeCategory. The AI content-analysis service is given the current
/// category's field list and asked to fill in a value per field when it
/// analyzes new content for that category.
model KnowledgeFieldDefinition {
  id        String       @id @default(uuid())
  name      String
  type      PropertyType
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  categoryId String
  category   KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  options KnowledgeFieldOption[]
  values  KnowledgeFieldValue[]
}

/// The choices for one SELECT-type field definition.
model KnowledgeFieldOption {
  id        String   @id @default(uuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  definitionId String
  definition   KnowledgeFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  values KnowledgeFieldValue[]
}

/// One saved thing — a URL (or a directly-sent JPG/PNG) the user dropped
/// into LINE, plus whatever the AI made of it. `categoryId` stays null while
/// `status` is PENDING/PROCESSING/AWAITING_CATEGORY_DECISION; once a
/// category is resolved (matched or freshly created) it's set and `status`
/// becomes DONE. `rawContent` is kept even after analysis (per the original
/// design brief's "保留原始資料") so a future model upgrade can re-analyze
/// without re-fetching the source.
model KnowledgeItem {
  id String @id @default(uuid())

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  categoryId String?
  category   KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status                KnowledgeItemStatus @default(PENDING)
  /// Set when the AI couldn't match any existing category — the name it
  /// suggested, shown to the user as "建議新增 XX 分類" while awaiting reply.
  suggestedCategoryName String?
  /// [{name, type}] the AI proposed for that new category — used verbatim
  /// if the user replies "新增"; kept separate from suggestedCategoryName
  /// since it's structured, not display text.
  suggestedFields       Json?
  errorMessage          String?

  sourceUrl      String?
  sourcePlatform String? // e.g. "IG", "YouTube", "網頁文章", "PDF", "圖片" — display only
  title          String?
  summary        String?
  tags           String[] @default([])
  rawContent     String?

  /// 圖片/影片來源的原始檔在 Supabase Storage（private bucket
  /// `knowledge-media`）裡的路徑 (2026-08-06) — 讓「顯示來源」「重新分析」
  /// 對圖片/影片也能用（本來分析完就丟了，完全沒地方可以再看/再分析）。
  /// Null 表示這筆是連結/純文字來源，本來就有 sourceUrl/rawContent 可用，
  /// 不需要另外存檔案。
  sourceFilePath String?

  /// Only used when category = 展覽資訊 — see KnowledgeExhibitionDecisionStatus.
  exhibitionDecisionStatus KnowledgeExhibitionDecisionStatus?
  exhibitionPlannedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldValues KnowledgeFieldValue[]

  @@index([ownerUserId, categoryId])
  @@index([status])
}

/// One item's value for one field definition. Exactly one of
/// textValue/numberValue/dateValue/booleanValue/optionId is populated,
/// chosen by `definition.type`.
model KnowledgeFieldValue {
  id String @id @default(uuid())

  textValue    String?
  numberValue  Float?
  dateValue    DateTime?
  booleanValue Boolean?

  optionId String?
  option   KnowledgeFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  itemId String
  item   KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  definitionId String
  definition   KnowledgeFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([itemId, definitionId])
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

/// One AI call's usage/cost — currently only 知識庫's Gemini calls log here,
/// but `feature` is a plain string (not an enum) so any future AI feature
/// can reuse this same table instead of growing a parallel one. Visible
/// only to the user themselves (see AiUsageService) — this is personal
/// spend tracking, not a platform-wide admin report.
model AiUsageLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String // e.g. "knowledge"
  model   String // e.g. "gemini-2.5-flash"

  inputTokens  Int
  outputTokens Int
  costUsd      Float
  durationMs   Int

  status       AiUsageStatus
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum LifeGoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

/// Where a LifeGoal's current number comes from (2026-09-30, after the
/// first all-manual version was judged 「有夠難用」). Only MANUAL uses the
/// stored `currentValue`; every other type is computed fresh on every read
/// by `LifeGoalProgressService`, so an auto-tracked number is never stale
/// and there's no sync job to drift.
enum LifeGoalTrackingType {
  MANUAL
  ACCOUNT_BALANCE // 指定記帳帳戶的餘額（trackingAccountId）
  NET_WORTH // 淨資產（跟財務報表同一套算法）
  NOTE_KEYWORD_SUM // 備註含 trackingKeyword 的收入＋轉帳金額累計
  STOCK_VALUE // 持股總市值
  CHECK_IN // LifeGoalCheckIn 的 value 加總（依 checkInPeriod 分期）
}

/// Only meaningful for CHECK_IN: which window of check-ins counts toward
/// `targetValue` — 「每週運動 3 次」 is WEEKLY (Taipei Mon–Sun), 「一年讀
/// 12 本書」 is TOTAL.
enum LifeGoalPeriod {
  TOTAL
  WEEKLY
  MONTHLY
}

/// 人生目標 (2026-09-29) — account-level like 知識庫/代辦事項 (not scoped to
/// any Space): a goal is inherently the owner's own, not something a space
/// would own. `targetValue`/`currentValue`/`unit` are all optional and
/// independent of each other — a goal with a number (「存到 150,000
/// 元」) shows a computed progress bar; a goal with none of the three
/// (「學會放鬆、不焦慮」) just shows status + `targetDate`, never forced
/// to fake a number. See `LifeGoalTrackingType` for where the number
/// comes from when it isn't typed by hand.
model LifeGoal {
  id String @id @default(uuid())

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title String
  notes String?

  /// 自由文字使用者自訂分類（例如「財務」「健康」）——不另開分類管理表，
  /// 跟知識庫刻意讓分類系統各自獨立、輕量的作法一致。
  category String?

  targetValue  Float?
  currentValue Float?  @default(0)
  /// 建立時的起點——進度＝(目前−起點)/(目標−起點)，這樣「體重 75→70」這種往下
  /// 的目標也算得對（73 公斤是 40%，不是 104%）。null 時視為 0（存錢這種從零開始的）。
  startValue   Float?
  unit         String? // 顯示用，例如「元」「本」「公斤」

  trackingType       LifeGoalTrackingType @default(MANUAL)
  trackingAccountId  String?
  trackingAccount    FinanceAccount?      @relation(fields: [trackingAccountId], references: [id], onDelete: SetNull)
  trackingKeyword    String?
  checkInPeriod      LifeGoalPeriod       @default(TOTAL)
  /// 讀書這類目標：打卡一定要寫心得／最喜歡的一句話才算數，證明真的看過。
  requireCheckInNote Boolean              @default(false)

  /// Last time the number actually moved by the user's hand (MANUAL edit or
  /// a check-in) — drives the 「14 天沒更新」 LINE nudge. Separate from
  /// `updatedAt`, which also bumps on unrelated edits like renaming.
  progressUpdatedAt DateTime?
  staleRemindedAt   DateTime?

  checkIns LifeGoalCheckIn[]

  targetDate  DateTime?      @db.Date
  status      LifeGoalStatus @default(ACTIVE)
  completedAt DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, status])
}

/// One 打卡 against a CHECK_IN LifeGoal — a finished book, a workout, etc.
/// `title` is what it was (書名), `note` is the proof (心得／最喜歡的一句
/// 話), required when the goal's `requireCheckInNote` is set.
model LifeGoalCheckIn {
  id String @id @default(uuid())

  goalId String
  goal   LifeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  value Float    @default(1)
  title String?
  note  String?

  createdAt DateTime @default(now())

  @@index([goalId, date])
}

/// App 裡「AI 問答」跟 LINE 共用同一個萬用 AI（2026-10-01）——這是 App 那邊的
/// 對話狀態，欄位跟 LineAccountLink 上的 ai* / pendingAi* 一樣意思。
model AppAiSession {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiInteractionId     String?
  aiInteractionAt     DateTime?
  pendingAiAction     Json?
  pendingAiActionTurn String?

  updatedAt DateTime @updatedAt
}

/// 日記（2026-10-01）——LINE/App 用講的就記，AI 順便判斷心情（1～5）跟標籤。
/// 一天可以有很多則。
model JournalEntry {
  id          String @id @default(uuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  date    DateTime @db.Date
  content String
  /// 1＝很差 … 5＝很好；沒判斷出來就是 null
  mood    Int?
  tags    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, date])
}

/// 梅花易數（2026-10-01）——說「我想算 XX」就用當下時間起卦，AI 依題目解卦，
/// 每次結果都留著可以回頭看。`reading` 是起卦算出來的卦象（本/互/變卦、體用、旺衰）。
model DivinationRecord {
  id          String @id @default(uuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  question       String
  castAt         DateTime
  hexagram       String
  reading        Json
  interpretation String

  /// 準不準（2026-10-01）：3＝準、2＝部分準、1＝不準；算完 7 天 LINE 會問一次
  /// （feedbackAskedAt），也可以在 App 自己按。之後解卦會參考過去的回饋。
  accuracy        Int?
  feedback        String?
  feedbackAt      DateTime?
  feedbackAskedAt DateTime?

  createdAt DateTime @default(now())

  @@index([ownerUserId, createdAt])
}

enum HealthRecordType {
  SLEEP
  EXERCISE
  WEIGHT
  STEPS
}

/// 健康（2026-10-01）——睡眠、運動、體重、步數。LINE 用講的、App 手動、
/// 或 iPhone 捷徑自動上傳（source＝SHORTCUT）。
/// - SLEEP：date＝起床那天；startAt/endAt＝幾點睡幾點起；minutes＝睡多久。
///   捷徑「睡覺」事件先建一筆只有 startAt 的，「起床」再補上 endAt。
/// - EXERCISE：activity（跑步/重訓…）＋minutes。
/// - WEIGHT：value＝公斤。STEPS：value＝當天步數。
/// externalKey：捷徑同一天同一種資料重傳時用來覆蓋，不會重複。
model HealthRecord {
  id          String @id @default(uuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  type     HealthRecordType
  date     DateTime         @db.Date
  startAt  DateTime?
  endAt    DateTime?
  minutes  Int?
  value    Float?
  activity String?
  note     String?
  source   String           @default("MANUAL")

  externalKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId, externalKey])
  @@index([ownerUserId, type, date])
}

/// AI 長期記憶（2026-10-01）：使用者講過、長期有效的事（喜好、禁忌、家人、
/// 工作、習慣），每次跟 AI 聊天都會帶進去。
model UserMemory {
  id          String   @id @default(uuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId])
}

/// 重要日子（2026-10-01）：生日、紀念日…每年重複；isLunar＝農曆（每年換算
/// 成國曆）。year 有填才算得出幾歲／第幾週年。前 7 天、前 1 天、當天 LINE
/// 提醒，lastRemindedKey 記「日期:剩幾天」避免重發。
model ImportantDate {
  id              String   @id @default(uuid())
  ownerUserId     String
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title           String
  month           Int
  day             Int
  year            Int?
  isLunar         Boolean  @default(false)
  note            String?
  lastRemindedKey String?
  createdAt       DateTime @default(now())

  @@index([ownerUserId])
}
